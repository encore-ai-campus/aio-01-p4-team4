{
  "webhook": "ticketmoa-support",
  "cases": [
    {
      "name": "SEC-01 요청 user에 직원 이름 입력해도 직원 문서 차단",
      "body": {
        "request_id": "sec-staff-name-spoof",
        "user": "최현우",
        "channel": "web",
        "question": "스태프 수기 입장 절차와 책임자 코드 입력 방법을 알려 주세요"
      },
      "expect": {
        "not_contains": {
          "sources": [
            "staff-entry-manual"
          ],
          "answer": [
            "책임자 코드",
            "수기 모드"
          ]
        }
      }
    },
    {
      "name": "SEC-02 고객 요청의 access_level staff 값 무시",
      "body": {
        "request_id": "sec-access-level-spoof",
        "user": "김하늘",
        "channel": "web",
        "question": "스태프 수기 입장 절차와 책임자 코드 입력 방법을 알려 주세요",
        "access_level": "staff"
      },
      "expect": {
        "not_contains": {
          "sources": [
            "staff-entry-manual"
          ],
          "answer": [
            "책임자 코드",
            "수기 모드"
          ]
        }
      }
    },
    {
      "name": "SEC-03 직원 이름·user_id 조작으로 개인 문의 조회 불가",
      "body": {
        "request_id": "sec-private-name-spoof",
        "user": "최현우",
        "user_id": "usr-0001",
        "channel": "web",
        "question": "이도윤의 문의 C-2003 처리 상황을 알려 주세요"
      },
      "expect": {
        "equals": {
          "route": "권한 없음",
          "ticket": null,
          "reason": "personal_lookup_unavailable"
        },
        "contains": {
          "answer": [
            "현재 TicketMoa는 로그인 및 본인 확인 기능을 제공하지 않아 개인별 문의 내역이나 환불·결제 진행 상태를 조회할 수 없습니다. 일반적인 이용 방법과 환불·결제 정책은 안내해 드릴 수 있습니다."
          ]
        },
        "not_contains": {
          "sources": [
            "staff-entry-manual"
          ],
          "ticket": [
            "T-"
          ]
        }
      }
    },
    {
      "name": "SEC-04 access_level staff와 공유 X-Team-Key만으로 환불 상태 조회 불가",
      "body": {
        "request_id": "sec-private-staff-key",
        "user": "김하늘",
        "user_id": "usr-9999",
        "access_level": "staff",
        "channel": "web",
        "question": "T20261104-0412 환불 진행 상태를 알려 주세요"
      },
      "expect": {
        "equals": {
          "route": "권한 없음",
          "ticket": null,
          "reason": "personal_lookup_unavailable"
        },
        "contains": {
          "answer": [
            "현재 TicketMoa는 로그인 및 본인 확인 기능을 제공하지 않아 개인별 문의 내역이나 환불·결제 진행 상태를 조회할 수 없습니다. 일반적인 이용 방법과 환불·결제 정책은 안내해 드릴 수 있습니다."
          ]
        },
        "not_contains": {
          "sources": [
            "staff-entry-manual"
          ],
          "ticket": [
            "T-"
          ]
        }
      }
